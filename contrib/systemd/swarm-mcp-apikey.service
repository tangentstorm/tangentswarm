# systemd *user* unit for swarm-mcp's Streamable HTTP mode gated by a static API key,
# bound to loopback (put a TLS reverse proxy in front if it must be reachable remotely).
#
#   swarm-mcp --gen-api-key                    # ~/.config/tangentswarm/api_key, mode 600
#   cp contrib/systemd/swarm-mcp-apikey.service ~/.config/systemd/user/
#   # edit --public-url to the externally visible URL of the endpoint (Host check)
#   systemctl --user daemon-reload && systemctl --user enable --now swarm-mcp-apikey
#
# The key grants full shell access as this user (shell_exec, send_keys...): every request
# without it gets 401 before any MCP handling. Keep --host 127.0.0.1.
[Unit]
Description=tangentswarm MCP server (Streamable HTTP + API key, loopback only)

[Service]
Environment=TANGENTSWARM_API_KEY_FILE=%h/.config/tangentswarm/api_key
ExecStart=%h/.venvs/tangentswarm/bin/swarm-mcp --http --auth-mode apikey --host 127.0.0.1 --port 8766 --public-url http://127.0.0.1:8766/mcp
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
