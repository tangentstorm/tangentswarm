# systemd *user* unit for swarm-mcp's Streamable HTTP mode gated by a static API key,
# bound to loopback (put a TLS reverse proxy in front if it must be reachable remotely).
#
# The server runs from its own checkout and venv, separate from any checkout agents work in,
# so it only changes when a commit is deliberately deployed there:
#
#   git clone --branch main https://github.com/tangentstorm/tangentswarm.git ~/srv/swarm-tmux
#   python3 -m venv ~/.venvs/swarm-tmux
#   ~/.venvs/swarm-tmux/bin/pip install -e ~/srv/swarm-tmux
#   ~/.venvs/swarm-tmux/bin/swarm-mcp --gen-api-key   # ~/.config/tangentswarm/api_key, mode 600
#   cp ~/srv/swarm-tmux/contrib/systemd/swarm-mcp-apikey.service ~/.config/systemd/user/
#   # edit --public-url to the externally visible URL of the endpoint (Host check)
#   systemctl --user daemon-reload && systemctl --user enable --now swarm-mcp-apikey
#
# To deploy a new commit: git -C ~/srv/swarm-tmux pull --ff-only, then
# systemctl --user restart swarm-mcp-apikey.
#
# --public-url also sets the only non-loopback Host the app accepts, so a reverse proxy serving
# the endpoint under another hostname must send that Host (e.g. proxy_set_header Host
# swarm.tangentcode.com).
#
# The key lets a client type into this user's tmux panes (send_keys, tell_agent...): every request
# without it gets 401 before any MCP handling. Keep --host 127.0.0.1.
[Unit]
Description=tangentswarm MCP server (Streamable HTTP + API key, loopback only)

[Service]
Environment=TANGENTSWARM_API_KEY_FILE=%h/.config/tangentswarm/api_key
WorkingDirectory=%h/srv/swarm-tmux
ExecStart=%h/.venvs/swarm-tmux/bin/swarm-mcp --http --auth-mode apikey --host 127.0.0.1 --port 8766 --public-url https://swarm.tangentcode.com/api/tmux/mcp
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
